{
  "name": "chatbot-desktop",
  "version": "1.0.0",
  "description": "Chatbot desktop application with AI",
  "author": "Sendo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.chatbot.desktop",
    "productName": "ChatBot Desktop",
    "files": [
      "**/*",
      ".env"
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.6.1",
    "groq-sdk": "^0.9.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^24.0.0"
  }
}
